# À renseigner dans Vercel → Project → Settings → Environment Variables.
# Ce fichier est un modèle public : ne jamais y enregistrer de vrais secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ORIGIN=https://mon-groupe-gym.vercel.app
RP_ID=mon-groupe-gym.vercel.app
RP_NAME=openGym
SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_64_CARACTERES_HEXA
BOOTSTRAP_INVITE_CODE=REMPLACER_PAR_32_CARACTERES_HEXA_MAJUSCULES
DEFAULT_LANG=fr
FIRST_USER_ADMIN=1
INVITE_ONLY=1
ALLOW_GUEST=0
PASSWORD_LOGIN=1
# Le build Vercel impose MEDIA_UPLOADS=0 et COACH_DISABLED=1 pour cette V1.
